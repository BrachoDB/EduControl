<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    tools:context=".ui.home.HomeActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hero Card Superior -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/dark_teal_hero"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/promedio_general"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:alpha="0.8"/>

                    <TextView
                        android:id="@+id/tvPromedioGeneral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 / 5.0"
                        android:textColor="@color/white"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tvMateriasMatriculadas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Asignaturas Matriculadas"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"
                        android:alpha="0.9"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Listado de Materias -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMaterias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_materia" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB for adding new Materia -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNuevaMateria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/nueva_materia"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary_emerald"
        app:iconTint="@color/white"
        app:icon="@android:drawable/ic_input_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
