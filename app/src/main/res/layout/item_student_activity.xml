<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvActivityIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_approved"
            android:gravity="center"
            android:text="📝"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActivityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/navy_hero"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Taller #1: Funciones Linear" />

            <TextView
                android:id="@+id/tvClassAndDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Matemáticas 10° • 15 Ago" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusOrGradeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_approved"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/badge_approved_text"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="4.80" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
