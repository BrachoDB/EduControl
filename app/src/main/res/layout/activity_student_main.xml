<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    tools:context=".ui.student.StudentMainActivity">

    <FrameLayout
        android:id="@+id/studentFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/studentBottomNav"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/studentBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_surface"
        app:elevation="8dp"
        app:itemIconTint="@color/primary_emerald"
        app:itemTextColor="@color/primary_emerald"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/menu_student_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
