<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Hero Card Teacher -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTeacherHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/navy_hero"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvTeacherGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/emerald_light"
                    android:textSize="16sp"
                    tools:text="Buenos días, Prof. Andrés 👋" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Panel de Gestión Académica"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvClassesCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_approved"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:textColor="@color/badge_approved_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="📚 2 Clases" />

                    <TextView
                        android:id="@+id/tvStudentsCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_completed"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:textColor="@color/badge_completed_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="👥 5 Alumnos" />

                    <TextView
                        android:id="@+id/tvActivitiesCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_pending"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:textColor="@color/badge_pending_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="📝 6 Tareas" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Alert Banner for Pending Grading -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPendingGradingAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/badge_pending_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/badge_pending_text"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📥"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvPendingGradingText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/badge_pending_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Tienes 1 entrega pendiente por calificar." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mis Clases -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Mis Clases"
            android:textColor="@color/navy_hero"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTeacherClasses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_teacher_class" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
